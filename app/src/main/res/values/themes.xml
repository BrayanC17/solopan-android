<resources>
    <style name="Theme.Solopan" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/cream_border</item>
        <item name="colorSecondary">@color/brown_dark</item>
        <item name="colorOnSecondary">@color/text_on_dark</item>
        <item name="colorSurface">@color/cream_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/cream_background</item>
        <item name="android:statusBarColor">@color/brown_dark</item>
        <item name="materialButtonStyle">@style/Widget.Solopan.Button</item>
    </style>

    <style name="Widget.Solopan.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/red_primary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Solopan.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/brown_dark</item>
        <item name="android:textColor">@color/brown_dark</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="Widget.Solopan.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingHorizontal">@dimen/spacing_m</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>