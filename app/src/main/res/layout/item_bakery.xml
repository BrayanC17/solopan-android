<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_m">

    <FrameLayout
        android:layout_width="@dimen/product_image_size"
        android:layout_height="@dimen/product_image_size"
        android:background="@drawable/bg_logo_circle">

        <ImageView
            android:layout_width="@dimen/logo_icon_size"
            android:layout_height="@dimen/logo_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_bakery" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBakeryName"
            style="@style/Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvBakeryInfo"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvBakeryHours"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/success_green"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>